# HoneyWatch 環境変数テンプレート
# このファイルをコピーして .env を作成し、値を設定してください。
# cp .env.example .env

# === 全般 ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === データベース (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=honeywatch
DB_PASSWORD=honeywatch
DB_NAME=honeywatch

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Honeypot ===
HONEYPOT_SSH_HOST=0.0.0.0
HONEYPOT_SSH_PORT=2222
HONEYPOT_SSH_MAX_AUTH_ATTEMPTS=10
HONEYPOT_SSH_TIMEOUT=30
HONEYPOT_SSH_HOST_KEY_DIR=data/ssh_host_keys
HONEYPOT_HTTP_HOST=0.0.0.0
HONEYPOT_HTTP_PORT=8080

# === API ===
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_USER=admin
API_AUTH_PASSWORD=changeme
